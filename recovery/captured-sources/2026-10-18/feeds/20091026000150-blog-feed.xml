		<link>http://bluescholars.com/blog/2009/10/massive-relief-massive-success/</link>
		<comments>http://bluescholars.com/blog/2009/10/massive-relief-massive-success/#comments</comments>
		<pubDate>Mon, 19 Oct 2009 19:54:10 +0000</pubDate>
		<dc:creator>Geo</dc:creator>
